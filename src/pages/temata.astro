---
import Zaklad from '../layouts/Zaklad.astro';
import TemaKarta from '../components/TemaKarta.astro';
import { nactiTemata } from '../lib/obsah';

const temata = await nactiTemata();
---
<Zaklad titulek="Témata" popis="Šest klíčových témat Regionu příležitostí a budoucnosti a jejich projekty.">
  <section class="obal temata">
    <p class="stitek">Témata</p>
    <h1>Šest klíčových témat</h1>
    <p class="perex">
      Nejvýznamnější pilíře konkurenceschopnosti, udržitelného rozvoje a kvality života v kraji. Každé téma dělíme na
      neinvestiční projekty a další řešené oblasti.
    </p>
    <div class="mrizka">
      {temata.map((t) => <TemaKarta polozka={t} />)}
    </div>
  </section>
</Zaklad>

<style>
  .temata {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: clamp(48px, 6vw, 72px);
  }
  h1 { font-size: clamp(36px, 5vw, 56px); }
  .perex { max-width: 640px; color: var(--text-perex); line-height: 1.55; }
  .mrizka {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 12px;
  }
  @media (max-width: 1024px) { .mrizka { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .mrizka { grid-template-columns: 1fr; } }
</style>
