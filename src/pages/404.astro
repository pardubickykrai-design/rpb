---
import Zaklad from '../layouts/Zaklad.astro';
---
<Zaklad titulek="Stránka nenalezena">
  <section class="obal chyba">
    <p class="stitek">Chyba 404</p>
    <h1>Tuto stránku jsme nenašli</h1>
    <p>Adresa mohla být změněna nebo zadána s překlepem.</p>
    <div class="akce">
      <a class="tlacitko tlacitko--plne" href="/projekty/">Katalog projektů</a>
      <a class="tlacitko tlacitko--obrys" href="/hledat/">Hledat na webu</a>
    </div>
  </section>
</Zaklad>

<style>
  .chyba {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-block: clamp(48px, 8vw, 96px);
    min-height: 50vh;
  }
  h1 { font-size: clamp(36px, 5vw, 56px); }
  .akce { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
